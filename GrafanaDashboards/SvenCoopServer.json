      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Spielzeit",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "ffmiw3njywo3ke"
                      },
                      "spec": {
                        "query": "import \"math\"\n\nfrom(bucket: \"svencoop\")\n  |> range(start: 0)\n  |> filter(fn: (r) => r._measurement == \"sc_players\" and r._field == \"score\")\n  |> group(columns: [\"player\"])\n  |> count()\n  // Umrechnung in Stunden (* 15 Sek / 3600)\n  |> map(fn: (r) => ({ r with Stunden: math.round(x: (float(v: r._value) * 15.0 / 3600.0) * 10.0) / 10.0 }))\n  |> keep(columns: [\"player\", \"Stunden\"])\n  |> group()\n  |> sort(columns: [\"Stunden\"], desc: true)\n\n"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {},
                      "includeByName": {},
                      "indexByName": {
                        "Stunden": 1,
                        "player": 0
                      },
                      "renameByName": {
                        "player": "Spieler"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "bargauge",
            "version": "13.3.0",
            "spec": {
              "options": {
                "displayMode": "lcd",
