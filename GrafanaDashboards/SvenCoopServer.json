      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Gesamtpunkte",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "ffmiw3njywo3ke"
                      },
                      "spec": {
                        "query": "from(bucket: \"svencoop\")\n  |> range(start: 0)\n  |> filter(fn: (r) => r._measurement == \"sc_players\" and r._field == \"score\" and r._value <= 10000)\n  |> group(columns: [\"player\"])\n  |> sort(columns: [\"_time\"], desc: false)\n  // Berechnet nur die Differenz zum vorherigen Messpunkt (ignoriert Abfälle auf 0)\n  |> difference(nonNegative: true)\n  // Filtert den fehlerhaften Rücksprung von 0 auf den alten Punktestand heraus (z. B. > 250 Punkte in 15 Sek.)\n  |> filter(fn: (r) => r._value <= 250)\n  // Alle validen Punktezuwächse zusammenzählen\n  |> sum()\n  |> keep(columns: [\"player\", \"_value\"])\n  |> rename(columns: {_value: \"Gesamtpunkte\"})\n  |> group()\n  |> sort(columns: [\"Gesamtpunkte\"], desc: true)\n"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
