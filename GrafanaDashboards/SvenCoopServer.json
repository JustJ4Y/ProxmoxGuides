                      "spec": {
                        "query": "import \"date\"\n\n// 1. Letzten Zeitpunkt finden, an dem der Server leer war (players == 0)\nlastEmpty = from(bucket: \"svencoop\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"sc_server\" and r._field == \"players\" and r._value == 0)\n  |> group()\n  |> sort(columns: [\"_time\"], desc: false)\n  |> last()\n  |> findRecord(fn: (key) => true, idx: 0)\n\n// 2. Aktuellen Status prüfen und Sitzungsdauer in Sekunden berechnen\nfrom(bucket: \"svencoop\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"sc_server\" and r._field == \"players\")\n  |> group()\n  |> sort(columns: [\"_time\"], desc: false)\n  |> last()\n  |> map(fn: (r) => ({\n      r with\n      _value: if r._value > 0 then uint(v: now()) / uint(v: 1000000000) - uint(v: lastEmpty._time) / uint(v: 1000000000) else uint(v: 0)\n  }))\n  |> keep(columns: [\"_time\", \"_value\"])\n"
                      }
                    },
                    "refId": "A",
                    "hidden": false
